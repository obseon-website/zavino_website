{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zavino-website",
  "account_id": "71e42a055d9f95bde3317d2f55c023ff",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "zavino-website" },
  ],
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "zavino-leads",
      "database_id": "557cb512-5302-4330-a841-45a9b3fe2038",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [{
    "name": "INQUIRY_EMAIL",
    "allowed_destination_addresses": ["leads@thezavino.com"],
    "allowed_sender_addresses": ["website@thezavino.com"]
  }],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://thezavino.com",
    "INQUIRY_EMAIL_ENABLED": "false"
  },
  "observability": { "enabled": true },
}
